<object class="GtkPaned">
    <child>
        <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
                <object class="GtkBox">
                    <property name="halign">GTK_ALIGN_FILL</property>
                    <style>
                        <class name="toolbar"/>
                        <class name="optifol_boxed"/>
                    </style>
                    <!-- TODO: toolbar buttons here -->
                    <child>
                        <object class="GtkBox">
                            <property name="hexpand">TRUE</property>
                            <property name="halign">GTK_ALIGN_END</property>
                            <child>
                                <object class="GtkEntry">
                                    <property name="sensitive">FALSE</property>
                                    <property name="placeholder-text">Search by Name</property>
                                </object>
                            </child>
                            <child>
                                <object class="GtkButton">
                                    <property name="sensitive">FALSE</property>
                                    <property name="icon-name">edit-find-symbolic</property>
                                    <property name="tooltip-text">Search Requirements</property>
                                </object>
                            </child>
                            <child>
                                <object class="GtkButton">
                                    <property name="sensitive">FALSE</property>
                                    <property name="icon-name">edit-clear-all-symbolic</property>
                                    <property name="tooltip-text">Clear Search</property>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>
            <child>
                <object class="GtkScrolledWindow">
                    <property name="vexpand">TRUE</property>
                    <child>
                        <object class="GtkColumnView">
                            <child>
                                <object class="GtkColumnViewColumn">
                                    <property name="title">Test Group</property>
                                    <property name="resizable">TRUE</property>
                                </object>
                            </child>
                            <child>
                                <object class="GtkColumnViewColumn">
                                    <property name="title">Requirement Name</property>
                                    <property name="resizable">TRUE</property>
                                </object>
                            </child>
                            <child>
                                <object class="GtkColumnViewColumn">
                                    <property name="title">Test Name</property>
                                    <property name="resizable">TRUE</property>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>
        </object>
    </child>
    <child>
        <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
                <object class="GtkBox">
                    <property name="halign">GTK_ALIGN_FILL</property>
                    <style>
                        <class name="toolbar"/>
                        <class name="optifol_boxed"/>
                    </style>
                    <!-- TODO: toolbar buttons here -->
                    <child>
                        <object class="GtkBox">
                            <property name="hexpand">TRUE</property>
                            <property name="halign">GTK_ALIGN_END</property>
                            <child>
                                <object class="GtkEntry">
                                    <property name="sensitive">FALSE</property>
                                    <property name="placeholder-text">Search by Name</property>
                                </object>
                            </child>
                            <child>
                                <object class="GtkButton">
                                    <property name="sensitive">FALSE</property>
                                    <property name="icon-name">edit-find-symbolic</property>
                                    <property name="tooltip-text">Search Requirements</property>
                                </object>
                            </child>
                            <child>
                                <object class="GtkButton">
                                    <property name="sensitive">FALSE</property>
                                    <property name="icon-name">edit-clear-all-symbolic</property>
                                    <property name="tooltip-text">Clear Search</property>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>
            <child>
                <object class="GtkScrolledWindow">
                    <property name="vexpand">TRUE</property>
                    <child>
                        <object class="GtkColumnView">
                            <child>
                                <object class="GtkColumnViewColumn">
                                    <property name="title">Test Group</property>
                                    <property name="resizable">TRUE</property>
                                </object>
                            </child>
                            <child>
                                <object class="GtkColumnViewColumn">
                                    <property name="title">Requirement Name</property>
                                    <property name="resizable">TRUE</property>
                                </object>
                            </child>
                            <child>
                                <object class="GtkColumnViewColumn">
                                    <property name="title">Test Name</property>
                                    <property name="resizable">TRUE</property>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>
        </object>
    </child>
</object>
