<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">

    <appender name="ConsoleAppender" class="org.apache.log4j.ConsoleAppender">
        <param name="Target" value="System.out"/>
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="[%d] [%p] [%c] %m%n"/>
        </layout>
    </appender>

    <logger name="SubprocessControl" additivity="false">
        <priority value="info"/>
        <appender-ref ref="ConsoleAppender"/>
    </logger>

    <logger name="UserTesting" additivity="false">
        <priority value="debug"/>
        <appender-ref ref="ConsoleAppender"/>
    </logger>

    <logger name="GUI" additivity="false">
        <priority value="debug"/>
        <appender-ref ref="ConsoleAppender"/>
    </logger>

    <logger name="LogicServices" additivity="false">
        <priority value="warn"/>
        <appender-ref ref="ConsoleAppender"/>
    </logger>

    <logger name="LogicServices.CNFNormalisation" additivity="false">
        <priority value="debug"/>
        <appender-ref ref="ConsoleAppender"/>
    </logger>

    <logger name="LogicServices.KnowledgeBase" additivity="false">
        <priority value="trace"/>
        <appender-ref ref="ConsoleAppender"/>
    </logger>

</log4j:configuration>
